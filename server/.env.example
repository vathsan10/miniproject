# Copy this file to .env and fill in values.

# SQLite for local dev. To move to Postgres, change the provider in
# schema.prisma to "postgresql" and point this at a Postgres connection string.
DATABASE_URL="file:./dev.db"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Any long random string. Used to sign JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# Razorpay TEST mode keys. Get them from https://dashboard.razorpay.com/app/keys
# (switch to "Test Mode" first). If left blank, the server automatically
# falls back to Mock Payment mode so top-ups still work for demos.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
